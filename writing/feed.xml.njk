---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>Gautam Joshi — Writing</title>
    <link>https://gautamjoshi.com/writing/</link>
    <description>Notes and writing from Gautam Joshi.</description>
    <language>en-us</language>
    {%- for post in collections.posts %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>https://gautamjoshi.com{{ post.url }}</link>
      <guid>https://gautamjoshi.com{{ post.url }}</guid>
      <pubDate>{{ post.date | dateToRfc822 }}</pubDate>
      <description>{{ post.data.summary }}</description>
    </item>
    {%- endfor %}
  </channel>
</rss>
