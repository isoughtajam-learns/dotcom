<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>try{document.documentElement.dataset.theme=localStorage.getItem('theme')||'paper';}catch(e){}</script>
<title>{% if title %}{{ title }} — {% endif %}Gautam Joshi</title>
<link rel="stylesheet" href="/style.css">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="Gautam Joshi — Writing" href="/feed.xml">
<meta property="og:type" content="website">
<meta property="og:title" content="{% if title %}{{ title }} — {% endif %}Gautam Joshi">
<meta property="og:description" content="{{ summary or 'Notes on building small, focused software.' }}">
<meta property="og:url" content="https://gautamjoshi.com{{ page.url }}">
<meta property="og:image" content="https://gautamjoshi.com{{ ogImage or '/images/og-image.jpg' }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if title %}{{ title }} — {% endif %}Gautam Joshi">
<meta name="twitter:description" content="{{ summary or 'Notes on building small, focused software.' }}">
<meta name="twitter:image" content="https://gautamjoshi.com{{ ogImage or '/images/og-image.jpg' }}">
</head>
<body>

  <div class="tile-grid" id="tile-grid" aria-hidden="true"></div>

  <main>
    {% if backHref %}
    <a href="{{ backHref }}" class="back-button">&larr; {{ backLabel }}</a>
    {% endif %}
    {{ content | safe }}

    <footer class="footer">
      <a href="/" class="mono">gautamjoshi.com</a>
      <div class="theme-switcher" id="theme-switcher"></div>
    </footer>
  </main>

  <script src="/tiles.js"></script>
  <script src="/theme-switcher.js"></script>
</body>
</html>
